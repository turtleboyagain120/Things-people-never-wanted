<?xml version="1.0" encoding="UTF-8"?>
<!-- ========== Ultra Custom IFRAME Loader - Data & Presets ========== -->
<iframeloader version="2.0.0" xmlns="https://iframe-loader.dev">
  
  <metadata>
    <name>Ultra Custom IFRAME Loader</name>
    <author>OneCompiler</author>
    <created>2024-01-01</created>
    <description>Advanced iframe loader with header injection, UTM encryption, dynamic resize, and analytics queue</description>
    <features>
      <feature>Custom Header Injection (X-Tracking-ID, X-Source, X-Campaign)</feature>
      <feature>SHA-256 Query Parameter Encryption</feature>
      <feature>Dynamic Content-Aware Resize with Aspect Ratio Lock</feature>
      <feature>Analytics Event Queue with Exponential Backoff Retry</feature>
      <feature>9 Loading Paths (Direct, /home, /embed, UTM, etc.)</feature>
      <feature>4 API Key Formats (apikey, token, key, access_token)</feature>
      <feature>Save/Load Settings via LocalStorage</feature>
      <feature>MutationObserver for Real-Time Content Resize</feature>
      <feature>CORS Proxy Support for Header Injection</feature>
    </features>
  </metadata>

  <presets>
    <preset id="default" name="Default Settings">
      <site>example.com</site>
      <mode>direct</mode>
      <utm source="iframe_loader" medium="embed" campaign="custom_viewer" term="" content=""/>
      <resize enabled="true" aspect_ratio="16:9" min_height="400px" max_height="2000px"/>
      <visual width="100%" height="85vh" scrolling="auto" border="3px" border_color="#ffffff" zoom="1.0"/>
      <analytics endpoint="https://httpbin.org/post" retry_max="5"/>
    </preset>

    <preset id="google" name="Google Search">
      <site>google.com</site>
      <mode>direct</mode>
      <resize aspect_ratio="4:3" min_height="500px"/>
    </preset>

    <preset id="youtube" name="YouTube Embed">
      <site>youtube.com</site>
      <mode>pathEmbed</mode>
      <resize aspect_ratio="16:9" min_height="360px" max_height="1080px"/>
    </preset>

    <preset id="github" name="GitHub Dashboard">
      <site>github.com</site>
      <mode>pathDashboard</mode>
      <api format="token" use_key="true"/>
    </preset>

    <preset id="marketing" name="Marketing Campaign">
      <site>landing.example.com</site>
      <mode>queryUTM</mode>
      <utm source="linkedin_ad" medium="cpc" campaign="q4_enterprise" term="abm_platform" content="variant_b"/>
      <headers tracking_id="cmp-45678" source="linkedin-outreach" campaign="q4-enterprise"/>
      <encryption enabled="true"/>
      <resize aspect_ratio="16:9" min_height="600px" max_height="1800px"/>
    </preset>

    <preset id="docs" name="Documentation Viewer">
      <site>docs.example.com</site>
      <mode>pathViewer</mode>
      <visual scrolling="yes" zoom="1.2"/>
      <resize auto_resize="false"/>
    </preset>
  </presets>

  <modes>
    <mode id="direct">Direct Load - opens the site exactly as typed</mode>
    <mode id="pathHome" path="/home">Adds /home to the URL</mode>
    <mode id="pathIndex" path="/index.html">Adds /index.html to the URL</mode>
    <mode id="pathEmbed" path="/embed">Adds /embed for embedded views</mode>
    <mode id="queryIframe" query="iframe=true">Adds ?iframe=true query parameter</mode>
    <mode id="queryUTM">Adds full customizable UTM parameters</mode>
    <mode id="pathDashboard" path="/dashboard">Adds /dashboard to the URL</mode>
    <mode id="pathMobile" path="/mobile">Adds /mobile for mobile version</mode>
    <mode id="queryEmbed" query="embed=true">Adds ?embed=true query parameter</mode>
    <mode id="pathViewer" path="/viewer">Adds /viewer for document viewing</mode>
  </modes>

  <api_formats>
    <format key="apikey">apikey=YOUR_KEY</format>
    <format key="token">token=YOUR_KEY</format>
    <format key="key">key=YOUR_KEY</format>
    <format key="access_token">access_token=YOUR_KEY</format>
  </api_formats>

  <sandbox_permissions>
    <permission value="">None - full permissions (unsafe)</permission>
    <permission value="allow-scripts allow-same-origin">Scripts + Same Origin access</permission>
    <permission value="allow-scripts">Scripts only</permission>
    <permission value="allow-forms allow-scripts">Forms + Scripts only</permission>
  </sandbox_permissions>

  <tracked_events>
    <event type="iframe_loaded">Fires when iframe finishes loading</event>
    <event type="iframe_click">Tracks clicks inside same-origin iframes</event>
    <event type="iframe_error">Captures load errors</event>
    <event type="iframe_resize">Logs when iframe is resized</event>
    <event type="settings_changed">Records configuration changes</event>
    <event type="analytics_flushed">Marks when event queue is sent</event>
  </tracked_events>

  <proxies>
    <proxy url="https://api.allorigins.win/raw" status="active" type="primary"/>
    <proxy url="https://corsproxy.io/" status="active" type="fallback"/>
    <proxy url="https://proxy.cors.sh/" status="active" type="alternative"/>
  </proxies>

  <analytics_config>
    <retry_policy>
      <max_retries>5</max_retries>
      <backoff_strategy>exponential</backoff_strategy>
      <base_delay_ms>2000</base_delay_ms>
      <max_delay_ms>60000</max_delay_ms>
    </retry_policy>
    <batching>
      <auto_flush_interval_ms>2000</auto_flush_interval_ms>
      <max_batch_size>50</max_batch_size>
    </batching>
    <endpoints>
      <endpoint url="https://httpbin.org/post" description="Test endpoint - echoes back"/>
      <endpoint url="https://your-analytics.com/collect" description="Production analytics"/>
    </endpoints>
  </analytics_config>
</iframeloader>