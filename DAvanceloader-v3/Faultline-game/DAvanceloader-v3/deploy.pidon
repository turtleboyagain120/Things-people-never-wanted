type("ENVIRONMENT: {environment}")

Make {artifact}; Content: f"{
  \"runtime\": \"pvm\",
  \"version\": \"2.1\",
  \"target\": \"{target}\",
  \"height\": {height},
  \"zoom\": {zoom},
  \"mode\": \"{mode}\",
  \"environment\": \"{environment}\",
